{
  "graphify-auto-sync": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/scripts/sync-graphify.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
